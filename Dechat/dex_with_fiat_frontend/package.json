{
  "name": "dechat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src --dir tests",
    "format": "prettier --write \"src\" \"tests/e2e\" \"*.{ts,mjs,json}\" \"*.md\" \"../../.github/workflows/*.{yaml,yml}\"",
    "check": "prettier --check \"src\" \"tests/e2e\" \"*.{ts,mjs,json}\" \"*.md\" \"../../.github/workflows/*.{yaml,yml}\"",
    "check:dependencies": "knip --dependencies",
    "test:unit": "vitest run",
    "typecheck": "pnpm typecheck:src && pnpm typecheck:tests",
    "typecheck:src": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --pool=forks --no-file-parallelism",
    "test:coverage:merge": "vitest run --mergeReports --coverage --reporter=default"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@sentry/nextjs": "^10.50.0",
    "@sentry/replay": "^10.68.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^14.6.1",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "jsqr": "1.4.0",
    "lucide-react": "^0.453.0",
    "next": "15.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.4",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "uuid": "^10.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "~30.0.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "15.3.8",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.1",
    "knip": "^6.48.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
